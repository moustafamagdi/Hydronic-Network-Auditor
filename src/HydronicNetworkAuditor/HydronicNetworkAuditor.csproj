  </PropertyGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <Target Name="DeployToRevit" AfterTargets="Build">
    <MakeDir Directories="$(RevitAddinsDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(RevitAddinsDir)\HydronicNetworkAuditor.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(AddinManifestPath)"
          DestinationFiles="$(RevitAddinsDir)\HydronicNetworkAuditor.addin"
          SkipUnchangedFiles="true" />
    <Message Text="Hydronic Network Auditor deployed to $(RevitAddinsDir)" Importance="high" />
  </Target>
